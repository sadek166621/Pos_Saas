# ==============================================================================
# SMARTPOS SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application General
APP_NAME="SmartPOS SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.yourdomain.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Connection (MySQL 8.x)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_saas
DB_USERNAME=pos_saas_user
DB_PASSWORD=StrongPasswordHere

# Session & Cache (Redis recommended for production SaaS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Redis Configuration (Optional for multi-server setups)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SaaS Subscription Rules
SAAS_TRIAL_DAYS=14
SAAS_GRACE_PERIOD_DAYS=3
SAAS_DEFAULT_CURRENCY=BDT
SAAS_DEFAULT_CURRENCY_SYMBOL="৳"

# Bangladeshi Payment Gateway Credentials (API Integration)
# bKash Merchant Checkout
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_SANDBOX=false

# Nagad Merchant API
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_private_key
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_SANDBOX=false

# SSLCommerz Multi-Gateway
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_SANDBOX=false

# Bangladeshi SMS Gateway (Greenweb / SSL Wireless / BulkSMSBD)
SMS_GATEWAY_PROVIDER=greenweb
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id

# Mail Server Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@possaas.com"
MAIL_FROM_NAME="${APP_NAME}"
